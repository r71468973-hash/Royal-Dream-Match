# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google AdMob Configuration (Set LIVE credentials)
# VITE_ADMOB_APP_ID: Your AdMob App ID (ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX)
VITE_ADMOB_APP_ID=""

# VITE_ADMOB_BANNER_ID: Your Live Banner Ad Unit ID
VITE_ADMOB_BANNER_ID=""

# VITE_ADMOB_INTERSTITIAL_ID: Your Live Interstitial Ad Unit ID
VITE_ADMOB_INTERSTITIAL_ID=""

# VITE_ADMOB_REWARDED_ID: Your Live Rewarded Ad Unit ID
VITE_ADMOB_REWARDED_ID=""

# VITE_ADMOB_TEST_MODE: Set to "false" to enable LIVE monetization
VITE_ADMOB_TEST_MODE="false"
